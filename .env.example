# 이 파일을 .env.dev(개발) 또는 .env.prod(시연)로 복사해서 값을 채운다.
# .env.* 파일은 절대 커밋하지 않는다 (.gitignore에 있음). 실제 값은 GitHub Secrets와 서버에만.

# 밖에서 들어오는 포트. .env.dev는 8413, .env.prod는 8414로 바꾼다. 8410·8411은 글결 블로그가 쓰고, 8412는 블로그 Nginx 설정이 가리켜서 피한다
PORT=8413
# 위 포트를 어느 주소에서 받을지. 비우면 127.0.0.1(이 컴퓨터 안에서만, 맥 로컬용).
# 학교 서버: 10.116.64.12 (Nginx 관리자가 이 주소로 부른다). 0.0.0.0은 서버에서 쓰지 않는다.
# 맥에서 같은 와이파이의 폰·키패드 노트북으로 시험할 때만 0.0.0.0
# BIND_ADDR=

# core 이미지 태그 (개발 develop, 시연 main, 되돌릴 때 sha-xxxxxxx)
CORE_TAG=develop

# AI 비서 이미지 태그 (mcp·agent 공통. 개발 develop, 시연 main)
ASSISTANT_TAG=develop

# 화면(web) 이미지 태그 (개발 develop, 시연 main)
WEB_TAG=develop

# API 게이트웨이(Spring Cloud Gateway) 이미지 태그 (개발 develop, 시연 main)
GATEWAY_TAG=develop
# 방 공기 판단(climate). 비우면 develop. 시연(.env.prod)은 climate main 이미지가 생기면 main
CLIMATE_TAG=develop

# Spring 프로필 (dev / prod)
SPRING_PROFILE=dev

# DB
DB_NAME=mspace
DB_USERNAME=mspace
DB_PASSWORD=

# 키패드 장치 토큰 (core의 POST /api/access/verify). 개발·시연 값을 다르게 둔다.
# 만들기: openssl rand -hex 32   → 값은 이 파일 말고 .env.dev / .env.prod 와 장치 .env 에만
MSPACE_DEVICE_TOKEN=
# 장치별 토큰(장치마다 따로, 그 방에만). 형식 deviceId:roomId:토큰 을 쉼표로. 공용 토큰과 다른 값으로 만든다
# 예: MSPACE_DEVICES=keypad-1:1:<openssl rand -hex 32>,qr-1:1:<…>,camera-2:2:<…>
# 위 공용 토큰은 지금 compose에서 필수다(장치를 다 옮긴 뒤에도). 비울 수 있게 바꾸는 건 따로 PR로
MSPACE_DEVICES=

# 로그인 토큰 서명값 (32바이트 이상). 만들기: openssl rand -base64 48
# 개발·시연 값을 다르게 둔다. 바꾸면 모두 다시 로그인해야 한다
JWT_SECRET=
# refresh 토큰 쿠키에 Secure(HTTPS로만). 운영은 true 그대로
# MSPACE_AUTH_COOKIE_SECURE=true

# 인증번호 메일 (팀 Gmail + 앱 비밀번호). false면 번호가 core 로그에만 찍힌다(시연 전 꼭 true)
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# AI 비서 모델 (gemini / ollama). Gemini 키는 Google AI Studio에서 만든다
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# core 경고 철회 판단기용 키를 따로 쓸 때만 (비우면 위 GEMINI_API_KEY를 같이 씀, core #117)
CORE_GEMINI_API_KEY=
# climate 오디 AI(켤 기기 고르기)용 키를 따로 쓸 때만 (비우면 위 GEMINI_API_KEY를 같이 씀, 시간당 4번·하루 40번만 부름)
CLIMATE_GEMINI_API_KEY=

# AI 비서 대화 맥락 저장소. 기본 redis(compose 안의 redis 컨테이너). Redis 없이 돌리려면 memory
# MEMORY_STORE=redis
# 시간표 저장소(mcp). 기본 redis. 메모리만 쓰려면 memory
# SCHEDULE_STORE=redis
# Redis 비밀번호 (필수, 비면 compose가 멈춘다). 만들기: openssl rand -hex 32 (영문·숫자만, URL에 들어간다)
# 개발·시연 값을 다르게 둔다. 바꾸면 redis·agent·mcp를 같이 다시 띄운다(up -d)
REDIS_PASSWORD=
