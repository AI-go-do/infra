# 이 파일을 .env.dev(개발) 또는 .env.prod(시연)로 복사해서 값을 채운다.
# .env.* 파일은 절대 커밋하지 않는다 (.gitignore에 있음). 실제 값은 GitHub Secrets와 서버에만.

# 밖에서 들어오는 포트. .env.dev는 8413, .env.prod는 8414로 바꾼다. 8410·8411은 글결 블로그가 쓰고, 8412는 블로그 Nginx 설정이 가리켜서 피한다
PORT=8413
# 위 포트를 어느 주소에서 받을지. 비우면 127.0.0.1(이 컴퓨터 안에서만, 맥 로컬용).
# 학교 서버: 10.116.64.12 (Nginx 관리자가 이 주소로 부른다). 0.0.0.0은 서버에서 쓰지 않는다.
# 맥에서 같은 와이파이의 폰·키패드 노트북으로 시험할 때만 0.0.0.0
# BIND_ADDR=

# core 이미지 태그 (개발 develop, 시연 main, 되돌릴 때 sha-xxxxxxx)
CORE_TAG=develop

# AI 비서 이미지 태그 (mcp·agent 공통. 개발 develop, 시연 main)
ASSISTANT_TAG=develop

# 화면(web) 이미지 태그 (개발 develop, 시연 main)
WEB_TAG=develop

# API 게이트웨이(Spring Cloud Gateway) 이미지 태그 (개발 develop, 시연 main)
GATEWAY_TAG=develop

# Spring 프로필 (dev / prod)
SPRING_PROFILE=dev

# DB
DB_NAME=mspace
DB_USERNAME=mspace
DB_PASSWORD=

# 키패드 장치 토큰 (core의 POST /api/access/verify). 개발·시연 값을 다르게 둔다.
# 만들기: openssl rand -hex 32   → 값은 이 파일 말고 .env.dev / .env.prod 와 장치 .env 에만
MSPACE_DEVICE_TOKEN=

# 로그인 토큰 서명값 (32바이트 이상). 만들기: openssl rand -base64 48
# 개발·시연 값을 다르게 둔다. 바꾸면 모두 다시 로그인해야 한다
JWT_SECRET=
# refresh 토큰 쿠키에 Secure(HTTPS로만). 운영은 true 그대로
# MSPACE_AUTH_COOKIE_SECURE=true

# 인증번호 메일 (팀 Gmail + 앱 비밀번호). false면 번호가 core 로그에만 찍힌다(시연 전 꼭 true)
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# AI 비서 모델 (gemini / ollama). Gemini 키는 Google AI Studio에서 만든다
LLM_PROVIDER=gemini
GEMINI_API_KEY=
